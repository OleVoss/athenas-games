---
import TagPill from "./TagPill.astro";
export interface Props {
    name: string;
    tags: string[];
}

const { name, tags } = Astro.props;
---

<div class="wrapper">
    <p class="title">{ name }</p>
    <div class="tag-list">
        {
            tags.map(tag => ( <TagPill text={ tag } /> ))
        }
    </div>
</div>

<style>
    .tag-list {
        display: flex;
        gap: var(--size-1)
    }

    .wrapper {
        border: solid var(--border-size-2) var(--stone-11);
        border-radius: var(--radius-2);
        padding: var(--size-2);
    }

    .title {
        font-size: var(--font-size-5);
    }
</style>